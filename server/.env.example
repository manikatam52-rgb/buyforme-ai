# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/buyforme?retryWrites=true&w=majority

# ---- PayPal Sandbox (server-side ONLY; never expose to the client) ----
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_CURRENCY=USD

# ---- Google Gemini ----
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest

# ---- Product discovery ----
# mock = clearly-labelled local mock catalogue; channel3 = real Channel3 API
PRODUCT_SOURCE=mock
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
# Channel3 locale (default US/USD). Supported: US,GB,EU,CA,AU... · USD,GBP,EUR...
CHANNEL3_COUNTRY=US
CHANNEL3_CURRENCY=USD
# Search mode: default (fast, structured filters) | agentic (natural-language briefs) | keyword (lowest latency)
CHANNEL3_MODE=default

# ---- APIMatic (optional; enables grounded PayPal API docs context) ----
APIMATIC_ENABLED=false
APIMATIC_API_KEY=

# ---- Zapier (optional; post-payment automation) ----
# Paste a "Webhooks by Zapier" Catch Hook URL. Fired ONLY after a verified capture.
ZAPIER_WEBHOOK_URL=

# ---- Elastic (optional; hybrid lexical + semantic product search) ----
# e.g. https://my-deployment.es.us-central1.cloud.elastic.co:443 (Elastic Cloud trial works)
ELASTIC_HOST=
ELASTIC_API_KEY=
ELASTIC_EMBEDDING_DIMS=768
ELASTIC_EMBEDDING_MODEL=text-embedding-004

# ---- Kernel (optional; read-only product-page research in a cloud browser) ----
# NEVER used for payment or auth flows — those URLs are refused server-side.
KERNEL_API_KEY=

# ---- Bryntum ----
# No env needed: the delivery-schedule feed lives at GET /api/schedule/delivery.
# The Bryntum Calendar/Scheduler component itself is rendered by the frontend.
