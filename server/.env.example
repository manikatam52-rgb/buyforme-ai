# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/buyforme?retryWrites=true&w=majority

# ---- PayPal Sandbox (server-side ONLY; never expose to the client) ----
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_CURRENCY=USD

# ---- Google Gemini ----
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ---- Product discovery ----
# mock = clearly-labelled local mock catalogue; channel3 = real Channel3 API
PRODUCT_SOURCE=mock
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.channel3.com

# ---- APIMatic (optional; enables grounded PayPal API docs context) ----
APIMATIC_ENABLED=false
APIMATIC_API_KEY=
